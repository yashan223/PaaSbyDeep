PORT=3001
# auto = Neon serverless for *.neon.tech hosts, standard pg Pool for all other PostgreSQL hosts
DB_DRIVER=auto
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paasbydeeep?sslmode=disable
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
REPOS_PATH=./data/repos
WEBHOOK_SECRET=change_this_webhook_secret
FRONTEND_URL=http://localhost:5173
# Optional: GitHub OAuth App credentials (for 1-click OAuth login; PAT works without these)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:3001
# Optional: default email for Certbot Let's Encrypt SSL installation
CERTBOT_EMAIL=
# Optional: override detected server IP shown for domain DNS A-record instructions
SERVER_PUBLIC_IP=
